---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Physics Experiments">
	<div class="hero">
		<h1>Physics <span class="text-gradient">Experiments</span></h1>
		<p class="subtitle">
			A collection of satisfying, visually driven simulations.
		</p>
	</div>

	<div class="experiments-grid">
		<a href="/experiments/bouncing-balls" class="card">
			<div class="card-content">
				<h2>Bouncing Balls</h2>
				<p>Watch balls collide and multiply in a satisfying chaotic loop.</p>
				<div class="arrow">→</div>
			</div>
			<div class="card-bg"></div>
		</a>

		<a href="/experiments/circle-painter" class="card">
			<div class="card-content">
				<h2>Circle Painter</h2>
				<p>
					Watch a ball paint the circle as it bounces, changing colors on each
					fill.
				</p>
				<div class="arrow">→</div>
			</div>
			<div class="card-bg"></div>
		</a>

		<a href="/experiments/growing-ball" class="card">
			<div class="card-content">
				<h2>Growing Ball</h2>
				<p>A ball grows with each bounce until it fills the entire circle.</p>
				<div class="arrow">→</div>
			</div>
			<div class="card-bg"></div>
		</a>

		<a href="/experiments/spirograph-classic" class="card">
			<div class="card-content">
				<h2>Spirograph Classic</h2>
				<p>Watch a hypotrochoid curve draw itself as a wheel rolls inside another.</p>
				<div class="arrow">→</div>
			</div>
			<div class="card-bg"></div>
		</a>

		<a href="/experiments/spirograph-harmonograph" class="card">
			<div class="card-content">
				<h2>Spirograph Harmonograph</h2>
				<p>Two rotating wheels connected by poles trace mesmerizing patterns.</p>
				<div class="arrow">→</div>
			</div>
			<div class="card-bg"></div>
		</a>
	</div>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: 4rem 0 6rem;
		animation: fadeIn 1s ease-out;
	}

	h1 {
		font-size: 4rem;
		margin-bottom: 1rem;
		letter-spacing: -2px;
	}

	.text-gradient {
		background: linear-gradient(
			45deg,
			var(--accent-color),
			var(--accent-light)
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.subtitle {
		font-size: 1.5rem;
		color: var(--text-secondary);
		font-weight: 300;
	}

	.experiments-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		padding: 0 1rem;
	}

	.card {
		position: relative;
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3); /* Dark shadow */
		border-radius: 16px;
		padding: 2rem;
		overflow: hidden;
		transition:
			transform 0.3s ease,
			border-color 0.3s ease,
			box-shadow 0.3s ease;
		backdrop-filter: blur(10px);
		display: block;
	}

	.card:not(.disabled):hover {
		transform: translateY(-5px);
		border-color: var(--accent-light);
		box-shadow: 0 8px 40px rgba(245, 203, 92, 0.1); /* Subtle yellow glow */
	}

	.card-content {
		position: relative;
		z-index: 10;
	}

	.card h2 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
		color: var(--text-primary);
	}

	.card p {
		color: var(--text-secondary);
		margin-bottom: 1.5rem;
		line-height: 1.5;
	}

	.arrow {
		font-size: 1.5rem;
		color: var(--accent-color);
		transition: transform 0.3s ease;
	}

	.card:hover .arrow {
		transform: translateX(10px);
	}

	.card-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(
			circle at top right,
			rgba(245, 203, 92, 0.1),
			transparent 60%
		);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.card:hover .card-bg {
		opacity: 1;
	}

	.card.disabled {
		opacity: 0.5;
		cursor: default;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
