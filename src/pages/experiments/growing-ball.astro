---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Growing Ball | Physics Experiments">
  <div class="canvas-container">
    <canvas id="simulation"></canvas>
    <div class="controls">
      <h1>Growing Ball</h1>
      <p>The ball grows with each bounce until it fills the circle.</p>
      <div class="control-group">
        <label for="speed-slider">Speed</label>
        <input
          type="range"
          id="speed-slider"
          min="0.1"
          max="2"
          step="0.1"
          value="1"
        />
        <div class="stats">
          Size: <span id="ball-size">5</span>% | Bounces: <span
            id="bounce-count">0</span
          > | Resets: <span id="reset-count">0</span>
        </div>
      </div>

      <div class="actions">
        <button id="reset-btn">Reset</button>
        <a href="/" class="back-link">← Back</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .canvas-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #000;
    overflow: hidden;
  }

  canvas {
    display: block;
  }

  .controls {
    position: absolute;
    top: 2rem;
    left: 2rem;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
    pointer-events: auto;
    max-width: 300px;
  }

  h1 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--accent-light);
  }

  p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .control-group {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  input[type="range"] {
    width: 100%;
    accent-color: var(--accent-color);
    margin-bottom: 0.5rem;
  }

  .stats {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  button {
    background: var(--accent-color);
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    transition: background 0.3s;
  }

  button:hover {
    background: var(--accent-light);
  }

  .back-link {
    font-size: 0.9rem;
    color: white;
    opacity: 0.7;
    transition: opacity 0.3s;
  }

  .back-link:hover {
    opacity: 1;
  }
</style>

<script>
  // Simulation State
  let timeScale = 1;

  const colors = [
    "#ff6b6b",
    "#feca57",
    "#48dbfb",
    "#1dd1a1",
    "#5f27cd",
    "#ff9ff3",
    "#54a0ff",
    "#00d2d3",
    "#ff9f43",
    "#ee5a24",
  ];
  let currentColorIndex = 0;

  const initialRadius = 10;
  const growthRate = 2; // pixels per bounce
  let bounceCount = 0;
  let resetCount = 0;

  class Ball {
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    targetRadius: number;
    color: string;

    constructor(x: number, y: number, r: number, color: string) {
      this.x = x;
      this.y = y;
      this.radius = r;
      this.targetRadius = r;
      this.color = color;
      // Init velocity
      const angle = Math.random() * Math.PI * 2;
      const speed = 6 + Math.random() * 2;
      this.vx = Math.cos(angle) * speed;
      this.vy = Math.sin(angle) * speed;
    }

    draw(ctx: CanvasRenderingContext2D) {
      // Draw with gradient for depth effect
      const gradient = ctx.createRadialGradient(
        this.x - this.radius * 0.3,
        this.y - this.radius * 0.3,
        0,
        this.x,
        this.y,
        this.radius,
      );
      gradient.addColorStop(0, this.lightenColor(this.color, 30));
      gradient.addColorStop(0.7, this.color);
      gradient.addColorStop(1, this.darkenColor(this.color, 20));

      ctx.beginPath();
      ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
      ctx.fillStyle = gradient;
      ctx.fill();
      ctx.closePath();
    }

    lightenColor(color: string, percent: number): string {
      const num = parseInt(color.replace("#", ""), 16);
      const amt = Math.round(2.55 * percent);
      const R = Math.min(255, (num >> 16) + amt);
      const G = Math.min(255, ((num >> 8) & 0x00ff) + amt);
      const B = Math.min(255, (num & 0x0000ff) + amt);
      return `rgb(${R}, ${G}, ${B})`;
    }

    darkenColor(color: string, percent: number): string {
      const num = parseInt(color.replace("#", ""), 16);
      const amt = Math.round(2.55 * percent);
      const R = Math.max(0, (num >> 16) - amt);
      const G = Math.max(0, ((num >> 8) & 0x00ff) - amt);
      const B = Math.max(0, (num & 0x0000ff) - amt);
      return `rgb(${R}, ${G}, ${B})`;
    }

    update() {
      this.x += this.vx * timeScale;
      this.y += this.vy * timeScale;

      // Smooth radius growth
      if (this.radius < this.targetRadius) {
        this.radius += (this.targetRadius - this.radius) * 0.1;
      }
    }

    grow() {
      this.targetRadius += growthRate;
    }

    // Add significant randomness on bounce for varied movement
    randomizeBounce() {
      const randomAngle = (Math.random() - 0.5) * 1.2; // +/- 0.6 radians (about 35 degrees)
      const speed = Math.sqrt(this.vx * this.vx + this.vy * this.vy);
      const currentAngle = Math.atan2(this.vy, this.vx);
      const newAngle = currentAngle + randomAngle;
      this.vx = Math.cos(newAngle) * speed;
      this.vy = Math.sin(newAngle) * speed;
    }
  }

  const canvas = document.getElementById("simulation") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const ballSizeEl = document.getElementById("ball-size") as HTMLSpanElement;
  const bounceCountEl = document.getElementById(
    "bounce-count",
  ) as HTMLSpanElement;
  const resetCountEl = document.getElementById(
    "reset-count",
  ) as HTMLSpanElement;

  let width = window.innerWidth;
  let height = window.innerHeight;
  let ball: Ball;

  // Container configuration
  let containerRadius = Math.min(width, height) * 0.4;
  let containerCenter = { x: width / 2, y: height / 2 };

  // Particles for burst effect
  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    color: string;
    life: number;
  }
  let particles: Particle[] = [];

  // Setup UI
  const speedSlider = document.getElementById(
    "speed-slider",
  ) as HTMLInputElement;
  speedSlider?.addEventListener("input", (e) => {
    timeScale = parseFloat((e.target as HTMLInputElement).value);
  });

  function updateStats() {
    // Calculate size as percentage of container
    const sizePercent = Math.floor((ball.radius / containerRadius) * 100);
    if (ballSizeEl) ballSizeEl.textContent = sizePercent.toString();
    if (bounceCountEl) bounceCountEl.textContent = bounceCount.toString();
    if (resetCountEl) resetCountEl.textContent = resetCount.toString();
  }

  // Setup Canvas
  function resize() {
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;

    containerCenter.x = width / 2;
    containerCenter.y = height / 2;
    containerRadius = Math.min(width, height) * 0.4;
  }
  window.addEventListener("resize", resize);
  resize();

  function init() {
    currentColorIndex = Math.floor(Math.random() * colors.length);
    bounceCount = 0;
    resetCount = 0;
    particles = [];
    ball = new Ball(
      containerCenter.x,
      containerCenter.y,
      initialRadius,
      colors[currentColorIndex],
    );
    updateStats();
  }

  function createBurstParticles() {
    const particleCount = 30;
    for (let i = 0; i < particleCount; i++) {
      const angle = (Math.PI * 2 * i) / particleCount;
      const speed = 3 + Math.random() * 4;
      particles.push({
        x: ball.x,
        y: ball.y,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        radius: 3 + Math.random() * 5,
        color: ball.color,
        life: 1,
      });
    }
  }

  function resetBall() {
    createBurstParticles();
    resetCount++;
    currentColorIndex = (currentColorIndex + 1) % colors.length;
    bounceCount = 0;
    ball = new Ball(
      containerCenter.x,
      containerCenter.y,
      initialRadius,
      colors[currentColorIndex],
    );
  }

  function checkContainerCollision(ball: Ball): boolean {
    const dx = ball.x - containerCenter.x;
    const dy = ball.y - containerCenter.y;
    const distance = Math.sqrt(dx * dx + dy * dy);

    if (distance + ball.radius > containerRadius) {
      const nx = dx / distance;
      const ny = dy / distance;

      ball.x = containerCenter.x + nx * (containerRadius - ball.radius);
      ball.y = containerCenter.y + ny * (containerRadius - ball.radius);

      const dot = ball.vx * nx + ball.vy * ny;
      ball.vx = ball.vx - 2 * dot * nx;
      ball.vy = ball.vy - 2 * dot * ny;

      // Add randomness to bounce direction
      ball.randomizeBounce();

      return true;
    }
    return false;
  }

  function updateParticles() {
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx * timeScale;
      p.y += p.vy * timeScale;
      p.life -= 0.02;
      p.radius *= 0.98;

      if (p.life <= 0) {
        particles.splice(i, 1);
      }
    }
  }

  function drawParticles() {
    for (const p of particles) {
      ctx.globalAlpha = p.life;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
      ctx.fillStyle = p.color;
      ctx.fill();
      ctx.closePath();
    }
    ctx.globalAlpha = 1;
  }

  function animate() {
    // Clear with subtle trail
    ctx.fillStyle = "rgba(36, 36, 35, 0.15)";
    ctx.fillRect(0, 0, width, height);

    // Draw Container
    ctx.beginPath();
    ctx.arc(
      containerCenter.x,
      containerCenter.y,
      containerRadius,
      0,
      Math.PI * 2,
    );
    ctx.strokeStyle = "#333533";
    ctx.lineWidth = 5;
    ctx.stroke();
    ctx.closePath();

    // Update and draw particles
    updateParticles();
    drawParticles();

    // Update ball
    ball.update();

    // Check collision
    if (checkContainerCollision(ball)) {
      ball.grow();
      bounceCount++;
      updateStats();

      // Check if ball fills the circle
      if (ball.targetRadius >= containerRadius * 0.9) {
        resetBall();
      }
    }

    // Draw the ball
    ball.draw(ctx);

    updateStats();

    requestAnimationFrame(animate);
  }

  init();
  animate();

  document.getElementById("reset-btn")?.addEventListener("click", init);
</script>
